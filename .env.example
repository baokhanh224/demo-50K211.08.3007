# Bản Python chỉ đọc PYTHON_DATABASE_URL, tránh dùng nhầm DATABASE_URL của bản Next.js.
PYTHON_DATABASE_URL="postgresql://USER:PASSWORD@HOST/quynh_nhu_python?sslmode=require"
SESSION_SECRET="replace-with-a-random-secret-at-least-32-characters"

# Tạo tài khoản khi khởi tạo dữ liệu mẫu trên CSDL mới. Giữ mật khẩu hiện có khi dùng CSDL cũ.
DEMO_USERNAME=""
DEMO_PASSWORD=""

VIETQR_BANK_BIN=""
VIETQR_ACCOUNT_NUMBER=""
VIETQR_ACCOUNT_NAME=""

# Cookie riêng để hai bản chạy song song mà không đăng xuất lẫn nhau.
PYTHON_COOKIE_NAME="qn_python_session"
