    "vercel-build": "prisma migrate deploy && prisma generate && next build",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@neondatabase/serverless": "^1.2.0",
    "@prisma/adapter-neon": "^6.19.3",
