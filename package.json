    "dotenv": "^18.0.10",
    "exceljs": "^4.4.0",
    "https-proxy-agent": "^9.1.0",
    "next": "^16.0.10",
    "pdfkit": "^0.17.2",
    "prisma": "^6.19.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/pdfkit": "^0.17.3",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.2",
    "pixelmatch": "^8.0.0",
